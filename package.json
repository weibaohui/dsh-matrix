{
  "name": "@weibaohui/dsh-matrix",
  "version": "0.1.0",
  "description": "dsh 插件 · 黑客帝国数字雨：对话窗口铺上经典的绿色字符雨背景——半角片假名雨柱倾泻而下、白炽雨头绿身拖尾，透明度/速度/密度/配色全部可调，字符在窗口上流动，代码在雨中生长。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "matrix",
    "digital-rain",
    "background",
    "canvas",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/rain.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-matrix.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-matrix#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-matrix/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
